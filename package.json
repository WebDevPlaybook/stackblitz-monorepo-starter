{
  "name": "stackblitz-monorepo-starter",
  "private": true,
  "workspaces": ["libs/*", "apps/*"],
  "scripts": {
    "build:all": "npm run build --workspaces --if-present",
    "build:libs": "npm run build -w @org/ui-components",
    "dev": "npm run build:libs && npm run dev -w react-app",
    "preview": "vite preview",
    "test": "npm run test --workspaces --if-present",
    "g:lib": "node tools/generators/generate.mjs lib",
    "g:react-lib": "node tools/generators/generate.mjs react-lib",
    "g:app": "node tools/generators/generate.mjs react-app"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "21.0.4",
    "typescript": "^5.5.0",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "5.0.5"
  }
}
